includes:
	- %rootDir%/../../konradmichalik/phpstan-typo3-preset/phpstan.neon.dist
	- phpstan-baseline.neon

parameters:
	level: 8

	# Typed class constants are PHP 8.3+ syntax; the preset's 100% constant
	# type-coverage requirement would otherwise force a floor of 8.3, one major
	# above what TYPO3 v13/v14 themselves require.
	type_coverage:
		constant: 0

	typo3:
		requestGetAttributeMapping:
			# Set by typo3/cms-backend/backend-routing for every backend request
			# that matched a route; PageTreeFilterMiddleware reads it to tell the
			# page tree's filter endpoint from the rest of the backend stack.
			route: TYPO3\CMS\Backend\Routing\Route|null

	type_perfect:
		# PSR-7 request handlers must accept the ServerRequestInterface, not a
		# concrete request class - narrowing framework entry-point parameters
		# would break the contract, so disable that one type-perfect check.
		narrow_param: false

	scanDirectories:
		- ../../vendor
	paths:
		- ../../Classes
		- ../../Configuration
		- ../../Tests/Unit
		- ../../Tests/Functional
	# ext_emconf.php/ext_localconf.php rely on TYPO3-injected globals
	# ($EM_CONF, $_EXTKEY) - never statically analysable, same as the main
	# extension's own root-level versions (outside these paths already).
	excludePaths:
		- ../../Tests/Functional/Fixtures/Extensions/*/ext_emconf.php
		- ../../Tests/Functional/Fixtures/Extensions/*/ext_localconf.php
