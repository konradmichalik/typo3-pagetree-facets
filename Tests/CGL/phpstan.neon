includes:
	- %rootDir%/../../konradmichalik/phpstan-typo3-preset/phpstan.neon.dist
	- phpstan-baseline.neon

parameters:
	level: 8

	type_perfect:
		# PSR-7 request handlers must accept the ServerRequestInterface, not a
		# concrete request class - narrowing framework entry-point parameters
		# would break the contract, so disable that one type-perfect check.
		narrow_param: false

	scanDirectories:
		- ../../vendor
	paths:
		- ../../Classes
		- ../../Configuration
		- ../../Tests/Unit
		- ../../Tests/Functional
