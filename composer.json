{
	"name": "konradmichalik/typo3-pagetree-facets",
	"description": "Pagetree Facets - Filterable page tree with an extensible filter tab API, built on the TYPO3 v14 BeforePageTreeIsFilteredEvent.",
	"license": [
		"GPL-2.0-or-later"
	],
	"type": "typo3-cms-extension",
	"authors": [
		{
			"name": "Konrad Michalik",
			"email": "hej@konradmichalik.dev",
			"role": "Maintainer"
		}
	],
	"require": {
		"php": "~8.3.0 || ~8.4.0 || ~8.5.0",
		"psr/event-dispatcher": "^1.0",
		"psr/http-message": "^1.0 || ^2.0",
		"typo3/cms-backend": "^14.0",
		"typo3/cms-core": "^14.0"
	},
	"require-dev": {
		"eliashaeussler/version-bumper": "^4.0.3",
		"phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
		"typo3/cms-base-distribution": "^14.0",
		"typo3/cms-seo": "^14.0",
		"typo3/testing-framework": "^9.0 || ^10.0"
	},
	"autoload": {
		"psr-4": {
			"KonradMichalik\\PagetreeFacets\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"KonradMichalik\\PagetreeFacets\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"eliashaeussler/version-bumper": true,
			"ergebnis/composer-normalize": true,
			"php-http/discovery": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"platform": {
			"php": "8.4.1"
		},
		"sort-packages": true
	},
	"extra": {
		"konradmichalik/php-cs-fixer-preset": {
			"copyright": 2026
		},
		"typo3/cms": {
			"Package": {
				"providesPackages": {}
			},
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"extension-key": "pagetree_facets",
			"version": "0.1.0",
			"web-dir": "public"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@cgl install"
		],
		"cgl": "@composer -d Tests/CGL --",
		"test": "@test:unit",
		"test:coverage": "phpunit -c phpunit.xml",
		"test:functional": "phpunit -c phpunit.functional.xml",
		"test:unit": "phpunit -c phpunit.xml --no-coverage"
	}
}
