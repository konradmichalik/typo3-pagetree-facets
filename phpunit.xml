<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".Build/phpunit"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
	<testsuites>
		<testsuite name="Unit">
			<directory>Tests/Unit</directory>
		</testsuite>
	</testsuites>
	<!-- ttt (TYPO3 Testing Terrarium): applies #[WithTca] and friends around each
	     test and restores the globals afterwards, whether the test passes or errors.
	     Unit config only - the functional suite runs on typo3/testing-framework,
	     which bootstraps its own TCA. -->
	<extensions>
		<bootstrap class="KonradMichalik\Ttt\TttExtension"/>
	</extensions>
	<coverage>
		<report>
			<clover outputFile=".Build/coverage/clover.xml"/>
		</report>
	</coverage>
	<source>
		<include>
			<directory>Classes</directory>
		</include>
	</source>
</phpunit>
